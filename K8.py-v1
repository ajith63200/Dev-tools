#!/bin/bash
#===============================================================================
# Kubernetes Cluster Setup (kubeadm + containerd + Calico) for Ubuntu Linux
#
# Usage : sudo ./k8s-install.sh
# Log   : /var/log/k8s-install.log
#
# Optional environment overrides:
#   K8S_VERSION_MINOR             Kubernetes minor repo channel   (default: v1.35)
#   CALICO_VERSION                Calico release tag              (default: v3.30.3)
#   POD_CIDR                      Pod network CIDR                (default: auto)
#   APISERVER_ADVERTISE_ADDRESS   API server advertise IP         (default: auto)
#===============================================================================

set -Eeuo pipefail

#-------------------------------------------------------------------------------
# Global variables
#-------------------------------------------------------------------------------
readonly SCRIPT_NAME="$(basename "$0")"
readonly LOG_FILE="/var/log/k8s-install.log"
readonly LOCK_FILE="/var/lock/k8s-install.lock"

readonly K8S_VERSION_MINOR="${K8S_VERSION_MINOR:-v1.35}"
readonly CALICO_VERSION="${CALICO_VERSION:-v3.30.3}"
readonly CALICO_MANIFEST_URL="https://raw.githubusercontent.com/projectcalico/calico/${CALICO_VERSION}/manifests/calico.yaml"
readonly CALICO_DEFAULT_CIDR="192.168.0.0/16"

readonly CRI_SOCKET="unix:///run/containerd/containerd.sock"
readonly K8S_KEYRING="/etc/apt/keyrings/kubernetes-apt-keyring.gpg"
readonly K8S_APT_LIST="/etc/apt/sources.list.d/kubernetes.list"
readonly K8S_MODULES_FILE="/etc/modules-load.d/k8s.conf"
readonly K8S_SYSCTL_FILE="/etc/sysctl.d/99-kubernetes-cri.conf"
readonly CONTAINERD_CONFIG="/etc/containerd/config.toml"
readonly ADMIN_CONF="/etc/kubernetes/admin.conf"
readonly KUBELET_CONF="/etc/kubernetes/kubelet.conf"
readonly KUBELET_CLIENT_CERT="/var/lib/kubelet/pki/kubelet-client-current.pem"
readonly JOIN_CMD_FILE="/root/k8s-join-command.sh"
readonly API_PORT="6443"

POD_CIDR="${POD_CIDR:-}"
CP_IP=""
JOIN_TOKEN=""
CA_HASH=""

# Non-interactive apt behaviour (no dpkg/needrestart prompts)
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a

# Colors (disabled automatically when stdout is not a terminal)
if [[ -t 1 ]]; then
    C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'
    C_BLUE=$'\033[0;34m'; C_CYAN=$'\033[0;36m'; C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
    C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_CYAN=""; C_BOLD=""; C_RESET=""
fi

#-------------------------------------------------------------------------------
# Logging helpers: colored output on terminal, plain text in the log file
#-------------------------------------------------------------------------------
_log() {
    local level="$1" color="$2"
    shift 2
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    printf '%s [%s] %s\n' "$ts" "$level" "$*" >>"$LOG_FILE" 2>/dev/null || true
    if [[ "$level" == "ERROR" ]]; then
        printf '%s[%s]%s %s\n' "$color" "$level" "$C_RESET" "$*" >&2
    else
        printf '%s[%s]%s %s\n' "$color" "$level" "$C_RESET" "$*"
    fi
}
log_info()    { _log "INFO"    "$C_BLUE"   "$@"; }
log_success() { _log "SUCCESS" "$C_GREEN"  "$@"; }
log_warning() { _log "WARNING" "$C_YELLOW" "$@"; }
log_error()   { _log "ERROR"   "$C_RED"    "$@"; }

# Abort the script with an error message
die() {
    log_error "$*"
    exit 1
}

# Executes a command, sends its output to the log file, aborts on failure
run() {
    log_info "Running: $*"
    if ! "$@" >>"$LOG_FILE" 2>&1; then
        die "Command failed: $* (see ${LOG_FILE} for details)"
    fi
}

# apt-get wrapper: waits for dpkg lock, keeps existing config files
apt_get() {
    run apt-get -y \
        -o DPkg::Lock::Timeout=300 \
        -o Dpkg::Options::=--force-confdef \
        -o Dpkg::Options::=--force-confold \
        "$@"
}

# Writes a file only when its content differs. Returns 0 if changed, 1 if not.
write_file_if_changed() {
    local path="$1" content="$2"
    if [[ -f "$path" ]] && [[ "$(cat "$path")" == "$content" ]]; then
        return 1
    fi
    printf '%s\n' "$content" >"$path"
    return 0
}

# kubectl bound to the cluster admin kubeconfig
kctl() { kubectl --kubeconfig "$ADMIN_CONF" "$@"; }

#-------------------------------------------------------------------------------
# Traps: error reporting, cleanup and interruption handling
#-------------------------------------------------------------------------------
on_error() {
    local line="$1" cmd="$2"
    log_error "Unexpected failure at line ${line}: ${cmd}"
}

on_exit() {
    local rc=$?
    if (( rc != 0 )); then
        log_error "${SCRIPT_NAME} aborted with exit code ${rc}. Review ${LOG_FILE}."
    fi
}

trap 'on_error "$LINENO" "$BASH_COMMAND"' ERR
trap on_exit EXIT
trap 'die "Interrupted by user."' INT TERM

#-------------------------------------------------------------------------------
# Validation helpers
#-------------------------------------------------------------------------------

# Root privileges are mandatory (checked before the log file is touched)
check_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        echo "ERROR: This script must be run as root. Try: sudo ${SCRIPT_NAME}" >&2
        exit 1
    fi
}

# Prepare the log file (root-only permissions because it may contain tokens)
init_log() {
    mkdir -p "$(dirname "$LOG_FILE")"
    touch "$LOG_FILE"
    chmod 600 "$LOG_FILE"
    printf '\n===== %s started at %s =====\n' "$SCRIPT_NAME" "$(date '+%F %T')" >>"$LOG_FILE"
}

# Prevent two simultaneous runs of this script
acquire_lock() {
    exec 200>"$LOCK_FILE"
    flock -n 200 || die "Another instance of ${SCRIPT_NAME} is already running."
}

# Validate configuration inputs
validate_config() {
    [[ "$K8S_VERSION_MINOR" =~ ^v1\.[0-9]+$ ]] \
        || die "K8S_VERSION_MINOR must look like v1.35 (got: ${K8S_VERSION_MINOR})."
}

# Ensure the OS is Ubuntu (or at least apt-based)
check_os() {
    log_info "Validating operating system..."
    [[ -r /etc/os-release ]] || die "/etc/os-release not found; unsupported OS."
    local os_id os_ver
    os_id="$(. /etc/os-release && echo "${ID:-unknown}")"
    os_ver="$(. /etc/os-release && echo "${VERSION_ID:-unknown}")"
    if [[ "$os_id" != "ubuntu" ]]; then
        log_warning "Detected '${os_id}', this script targets Ubuntu."
        command -v apt-get >/dev/null 2>&1 || die "apt-get not available; unsupported OS."
    else
        log_success "Ubuntu ${os_ver} detected."
    fi
}

# curl is required by several later steps
ensure_curl() {
    if ! command -v curl >/dev/null 2>&1; then
        log_info "curl not found; installing it..."
        apt_get update
        apt_get install curl
    fi
}

# Validate outbound internet connectivity to required endpoints
check_internet() {
    log_info "Validating internet connectivity..."
    ensure_curl
    local url
    for url in "https://pkgs.k8s.io" "https://registry.k8s.io"; do
        if ! curl -fsSI --max-time 15 "$url" >/dev/null 2>&1; then
            die "Cannot reach ${url}. Check network, proxy or DNS settings."
        fi
    done
    log_success "Internet connectivity verified."
}

# Sanity-check host resources (control plane needs at least 2 CPUs)
check_resources() {
    local role="$1" cpus mem_mb
    cpus="$(nproc)"
    mem_mb="$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)"
    log_info "Host resources: ${cpus} vCPU, ${mem_mb} MB RAM."
    if [[ "$role" == "control-plane" ]]; then
        (( cpus >= 2 )) || die "Control plane requires at least 2 CPUs (found ${cpus})."
        (( mem_mb >= 1700 )) || log_warning "Control plane recommends >= 2 GB RAM (found ${mem_mb} MB)."
    else
        (( mem_mb >= 900 )) || log_warning "Worker recommends >= 1 GB RAM (found ${mem_mb} MB)."
    fi
}

# Non-fatal environment warnings (firewall, time sync, hostname)
check_environment_warnings() {
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
        log_warning "UFW is active. Ensure Kubernetes ports (6443, 10250, 2379-2380, CNI) are allowed."
    fi
    if [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo unknown)" == "no" ]]; then
        log_warning "System clock is not NTP-synchronized; certificate/token validation may fail."
    fi
    if [[ "$(hostname)" == "localhost" ]]; then
        log_warning "Hostname is 'localhost'; use a unique hostname per node."
    fi
}

# Validate an IPv4 address (each octet 0-255)
is_valid_ipv4() {
    local ip="$1" octet
    [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    for octet in "${BASH_REMATCH[@]:1}"; do
        (( 10#$octet <= 255 )) || return 1
    done
    return 0
}

#-------------------------------------------------------------------------------
# Node preparation (shared by control plane and worker)
#-------------------------------------------------------------------------------

# Update OS packages and install base dependencies
update_os() {
    log_info "Updating OS packages..."
    apt_get update
    apt_get upgrade
    apt_get install apt-transport-https ca-certificates curl gpg
    if [[ -f /var/run/reboot-required ]]; then
        log_warning "A reboot is recommended after this run (kernel/library updates)."
    fi
    log_success "OS packages updated."
}

# Disable swap now and permanently (idempotent)
disable_swap() {
    log_info "Disabling swap..."
    if [[ -n "$(swapon --show 2>/dev/null)" ]]; then
        run swapoff -a
    else
        log_info "Swap is already off at runtime."
    fi
    # Comment out swap entries in /etc/fstab so swap stays off after reboot
    if grep -Eq '^[^#].*[[:space:]]swap[[:space:]]' /etc/fstab; then
        cp -a /etc/fstab "/etc/fstab.bak.$(date +%s)"
        sed -ri '/^[^#].*[[:space:]]swap[[:space:]]/ s/^/#/' /etc/fstab
        log_success "Swap entries commented out in /etc/fstab."
    else
        log_info "No active swap entries in /etc/fstab."
    fi
    [[ -z "$(swapon --show 2>/dev/null)" ]] || die "Swap is still active after swapoff."
    log_success "Swap disabled permanently."
}

# Load kernel modules required by containerd and Kubernetes networking
load_kernel_modules() {
    log_info "Configuring kernel modules (overlay, br_netfilter)..."
    if write_file_if_changed "$K8S_MODULES_FILE" $'overlay\nbr_netfilter'; then
        log_success "Wrote ${K8S_MODULES_FILE}."
    else
        log_info "${K8S_MODULES_FILE} already up to date."
    fi
    run modprobe overlay
    run modprobe br_netfilter
    lsmod | grep -q '^overlay' || die "Kernel module 'overlay' failed to load."
    lsmod | grep -q '^br_netfilter' || die "Kernel module 'br_netfilter' failed to load."
    log_success "Kernel modules loaded."
}

# Configure sysctl parameters for Kubernetes networking
configure_sysctl() {
    log_info "Configuring sysctl parameters..."
    local content
    content=$'net.bridge.bridge-nf-call-iptables  = 1\nnet.bridge.bridge-nf-call-ip6tables = 1\nnet.ipv4.ip_forward                 = 1'
    if write_file_if_changed "$K8S_SYSCTL_FILE" "$content"; then
        log_success "Wrote ${K8S_SYSCTL_FILE}."
    else
        log_info "${K8S_SYSCTL_FILE} already up to date."
    fi
    run sysctl --system
    [[ "$(sysctl -n net.ipv4.ip_forward)" == "1" ]] || die "net.ipv4.ip_forward is not enabled."
    [[ "$(sysctl -n net.bridge.bridge-nf-call-iptables)" == "1" ]] || die "bridge-nf-call-iptables is not enabled."
    log_success "Sysctl settings applied."
}

# Install containerd from the Ubuntu repositories
install_containerd() {
    log_info "Installing containerd..."
    apt_get install containerd
    log_success "containerd installed."
}

# Generate/adjust containerd config (systemd cgroup driver) and enable the service
configure_containerd() {
    log_info "Configuring containerd..."
    mkdir -p "$(dirname "$CONTAINERD_CONFIG")"

    local before="" after=""
    if [[ -f "$CONTAINERD_CONFIG" ]]; then
        before="$(md5sum "$CONTAINERD_CONFIG" | awk '{print $1}')"
    fi

    # Generate a default config only if missing/empty or lacking the cgroup option
    if [[ ! -s "$CONTAINERD_CONFIG" ]] || ! grep -q 'SystemdCgroup' "$CONTAINERD_CONFIG"; then
        if [[ -s "$CONTAINERD_CONFIG" ]]; then
            cp -a "$CONTAINERD_CONFIG" "${CONTAINERD_CONFIG}.bak.$(date +%s)"
        fi
        containerd config default >"$CONTAINERD_CONFIG" 2>>"$LOG_FILE" \
            || die "Failed to generate default containerd configuration."
    fi

    # Kubelet and containerd must both use the systemd cgroup driver
    sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' "$CONTAINERD_CONFIG"
    grep -q 'SystemdCgroup = true' "$CONTAINERD_CONFIG" \
        || die "Could not enable SystemdCgroup in ${CONTAINERD_CONFIG}."

    after="$(md5sum "$CONTAINERD_CONFIG" | awk '{print $1}')"

    run systemctl enable containerd
    if [[ "$before" != "$after" ]] || ! systemctl is-active --quiet containerd; then
        run systemctl restart containerd
    fi
    systemctl is-active --quiet containerd || die "containerd service is not running."
    log_success "containerd configured, enabled and running."
}

# Add the official Kubernetes apt repository for the selected minor version
add_k8s_repo() {
    log_info "Configuring Kubernetes apt repository (${K8S_VERSION_MINOR})..."
    local base="https://pkgs.k8s.io/core:/stable:/${K8S_VERSION_MINOR}/deb"
    local tmp
    mkdir -p /etc/apt/keyrings
    tmp="$(mktemp)"
    if ! curl -fsSL --retry 3 --retry-delay 2 "${base}/Release.key" -o "$tmp"; then
        rm -f "$tmp"
        die "Cannot download the Kubernetes repo key for ${K8S_VERSION_MINOR}. Verify the version exists."
    fi
    if ! gpg --dearmor --batch --yes -o "$K8S_KEYRING" "$tmp" >>"$LOG_FILE" 2>&1; then
        rm -f "$tmp"
        die "Failed to import the Kubernetes repository key."
    fi
    rm -f "$tmp"
    chmod 644 "$K8S_KEYRING"
    write_file_if_changed "$K8S_APT_LIST" "deb [signed-by=${K8S_KEYRING}] ${base}/ /" || true
    apt_get update
    log_success "Kubernetes repository configured."
}

# Install kubeadm/kubelet (+ kubectl on control plane) and hold their versions
install_kubernetes_packages() {
    local role="$1"
    local -a pkgs=(kubelet kubeadm)
    if [[ "$role" == "control-plane" ]]; then
        pkgs+=(kubectl)
    fi
    add_k8s_repo
    log_info "Installing Kubernetes packages: ${pkgs[*]}..."
    apt_get install "${pkgs[@]}"
    # Prevent unintended upgrades that could break the cluster version skew
    run apt-mark hold "${pkgs[@]}"
    run systemctl enable kubelet
    log_success "Kubernetes packages installed and held: ${pkgs[*]}"
}

# Align containerd's sandbox (pause) image with the one kubeadm expects; set up crictl
align_runtime_settings() {
    log_info "Aligning containerd sandbox image with kubeadm..."
    local pause_img
    pause_img="$(kubeadm config images list --kubernetes-version "$(kubeadm version -o short)" 2>/dev/null \
        | grep '/pause:' | head -n1 || true)"
    if [[ -n "$pause_img" ]]; then
        local before after
        before="$(md5sum "$CONTAINERD_CONFIG" | awk '{print $1}')"
        if grep -Eq '^[[:space:]]*sandbox_image[[:space:]]*=' "$CONTAINERD_CONFIG"; then
            sed -Ei "s|^([[:space:]]*sandbox_image[[:space:]]*=[[:space:]]*).*|\1\"${pause_img}\"|" "$CONTAINERD_CONFIG"
        elif grep -Eq "^[[:space:]]*sandbox[[:space:]]*=" "$CONTAINERD_CONFIG"; then
            sed -Ei "s|^([[:space:]]*sandbox[[:space:]]*=[[:space:]]*).*|\1'${pause_img}'|" "$CONTAINERD_CONFIG"
        fi
        after="$(md5sum "$CONTAINERD_CONFIG" | awk '{print $1}')"
        if [[ "$before" != "$after" ]]; then
            run systemctl restart containerd
            log_success "Sandbox image set to ${pause_img}."
        else
            log_info "Sandbox image already aligned."
        fi
    else
        log_warning "Could not determine the pause image; leaving containerd default."
    fi

    # Point crictl at containerd
    write_file_if_changed /etc/crictl.yaml $'runtime-endpoint: unix:///run/containerd/containerd.sock\nimage-endpoint: unix:///run/containerd/containerd.sock' || true
    systemctl is-active --quiet containerd || die "containerd is not running after configuration."
}

# Steps common to both node types
prepare_node() {
    local role="$1"
    check_os
    check_internet
    check_resources "$role"
    check_environment_warnings
    update_os
    disable_swap
    load_kernel_modules
    configure_sysctl
    install_containerd
    configure_containerd
    install_kubernetes_packages "$role"
    align_runtime_settings
}

#-------------------------------------------------------------------------------
# Control plane specific functions
#-------------------------------------------------------------------------------

# Pull control-plane container images ahead of init
pull_k8s_images() {
    log_info "Pulling required Kubernetes images (this can take a few minutes)..."
    run kubeadm config images pull --cri-socket "$CRI_SOCKET"
    log_success "Kubernetes images pulled."
}

# Choose a pod CIDR that does not overlap with any local network
detect_pod_cidr() {
    if [[ -n "$POD_CIDR" ]]; then
        log_info "Using user-provided pod CIDR: ${POD_CIDR}"
        return 0
    fi
    local host_ips entry cidr re
    host_ips="$(ip -4 -o addr show scope global | awk '{print $4}')"
    local -a candidates=(
        "192.168.0.0/16|^192\\.168\\."
        "10.244.0.0/16|^10\\.244\\."
        "172.20.0.0/16|^172\\.20\\."
    )
    for entry in "${candidates[@]}"; do
        cidr="${entry%%|*}"
        re="${entry#*|}"
        if ! grep -Eq "$re" <<<"$host_ips"; then
            POD_CIDR="$cidr"
            break
        fi
    done
    [[ -n "$POD_CIDR" ]] || die "No non-overlapping pod CIDR found. Set POD_CIDR manually."
    log_info "Selected pod CIDR: ${POD_CIDR}"
}

# Determine the primary IPv4 address used for the default route
detect_primary_ip() {
    ip -4 route get 1.1.1.1 2>/dev/null \
        | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}' || true
}

# Wait until the API server answers readiness probes
wait_for_api() {
    local timeout="$1" elapsed=0
    while (( elapsed < timeout )); do
        if kctl get --raw=/readyz >/dev/null 2>&1; then
            return 0
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    return 1
}

# Initialize the control plane with kubeadm (skipped if already initialized)
init_control_plane() {
    if [[ -f "$ADMIN_CONF" ]]; then
        log_warning "Existing control plane detected (${ADMIN_CONF}); skipping kubeadm init."
        run systemctl enable --now kubelet
        wait_for_api 120 \
            || die "Existing control plane is not responding. If intentional, run 'kubeadm reset -f' and retry."
        return 0
    fi

    detect_pod_cidr
    local advertise_ip="${APISERVER_ADVERTISE_ADDRESS:-$(detect_primary_ip)}"
    [[ -n "$advertise_ip" ]] || die "Could not detect the API server address. Set APISERVER_ADVERTISE_ADDRESS."
    is_valid_ipv4 "$advertise_ip" || die "Invalid advertise address: ${advertise_ip}"

    log_info "Initializing control plane (advertise: ${advertise_ip}, pod CIDR: ${POD_CIDR})..."
    if ! kubeadm init \
            --apiserver-advertise-address "$advertise_ip" \
            --pod-network-cidr "$POD_CIDR" \
            --cri-socket "$CRI_SOCKET" 2>&1 | tee -a "$LOG_FILE"; then
        die "kubeadm init failed. Review the output above and ${LOG_FILE}."
    fi
    [[ -f "$ADMIN_CONF" ]] || die "kubeadm init completed but ${ADMIN_CONF} is missing."
    log_success "Control plane initialized."
}

# Configure kubectl for the invoking (non-root) user, or root when run directly
configure_kubectl_user() {
    local target_user="${SUDO_USER:-root}" target_home target_group
    target_home="$(getent passwd "$target_user" | cut -d: -f6)"
    [[ -n "$target_home" && -d "$target_home" ]] || die "Cannot resolve home directory for ${target_user}."
    target_group="$(id -gn "$target_user")"

    log_info "Configuring kubectl for user '${target_user}'..."
    mkdir -p "${target_home}/.kube"
    cp -f "$ADMIN_CONF" "${target_home}/.kube/config"
    chown -R "${target_user}:${target_group}" "${target_home}/.kube"
    chmod 600 "${target_home}/.kube/config"
    log_success "kubectl configured at ${target_home}/.kube/config."
}

# Read the pod CIDR of an already-initialized cluster
get_existing_pod_cidr() {
    kctl -n kube-system get cm kubeadm-config -o jsonpath='{.data.ClusterConfiguration}' 2>/dev/null \
        | awk '/podSubnet:/ {print $2}' || true
}

# Install the Calico CNI plugin (skipped if already present)
install_calico() {
    log_info "Installing Calico CNI ${CALICO_VERSION}..."
    if kctl -n kube-system get daemonset calico-node >/dev/null 2>&1; then
        log_info "Calico is already installed; skipping."
    else
        if [[ -z "$POD_CIDR" ]]; then
            POD_CIDR="$(get_existing_pod_cidr)"
            [[ -n "$POD_CIDR" ]] || POD_CIDR="$CALICO_DEFAULT_CIDR"
        fi
        local manifest
        manifest="$(mktemp /tmp/calico.XXXXXX.yaml)"
        if ! curl -fsSL --retry 3 --retry-delay 2 "$CALICO_MANIFEST_URL" -o "$manifest"; then
            rm -f "$manifest"
            die "Failed to download Calico manifest: ${CALICO_MANIFEST_URL}"
        fi

        # Make Calico's IP pool match the cluster pod CIDR
        sed -i \
            -e 's|^\([[:space:]]*\)# - name: CALICO_IPV4POOL_CIDR|\1- name: CALICO_IPV4POOL_CIDR|' \
            -e "s|^\([[:space:]]*\)#   value: \"192.168.0.0/16\"|\1  value: \"${POD_CIDR}\"|" \
            "$manifest"
        if ! grep -Eq '^[[:space:]]*- name: CALICO_IPV4POOL_CIDR' "$manifest"; then
            if [[ "$POD_CIDR" != "$CALICO_DEFAULT_CIDR" ]]; then
                log_warning "Could not set Calico pool CIDR; pod CIDR (${POD_CIDR}) may not match Calico's default."
            fi
        fi

        run kubectl --kubeconfig "$ADMIN_CONF" apply -f "$manifest"
        rm -f "$manifest"
    fi

    log_info "Waiting for Calico to become ready..."
    run kubectl --kubeconfig "$ADMIN_CONF" -n kube-system rollout status daemonset/calico-node --timeout=300s
    log_success "Calico CNI installed."
}

# Generate the worker join command, store it securely and display it
generate_join_command() {
    log_info "Generating worker join command..."
    local join_cmd
    join_cmd="$(kctl -n kube-system get pods >/dev/null 2>&1 && kubeadm token create --print-join-command 2>>"$LOG_FILE")" \
        || die "Failed to generate join command."
    [[ "$join_cmd" == kubeadm\ join* ]] || die "Unexpected join command output: ${join_cmd}"

    printf '#!/bin/bash\n# Generated %s (token valid for 24h)\nsudo %s\n' "$(date '+%F %T')" "$join_cmd" >"$JOIN_CMD_FILE"
    chmod 600 "$JOIN_CMD_FILE"
    printf '%s [INFO] Join command generated and saved to %s\n' "$(date '+%F %T')" "$JOIN_CMD_FILE" >>"$LOG_FILE"

    echo
    echo "${C_CYAN}===================================================${C_RESET}"
    echo "${C_BOLD} Run this command on each worker node (as root):${C_RESET}"
    echo "${C_CYAN}===================================================${C_RESET}"
    echo "${C_GREEN}sudo ${join_cmd}${C_RESET}"
    echo "${C_CYAN}===================================================${C_RESET}"
    echo "Saved to: ${JOIN_CMD_FILE} (token expires in 24 hours)"
    echo "Regenerate later with: kubeadm token create --print-join-command"
    echo
}

# Validate control plane and cluster health
validate_cluster() {
    log_info "Validating cluster status..."
    wait_for_api 120 || die "API server is not ready."
    run kubectl --kubeconfig "$ADMIN_CONF" wait --for=condition=Ready node --all --timeout=300s
    run kubectl --kubeconfig "$ADMIN_CONF" -n kube-system rollout status deployment/coredns --timeout=300s

    echo
    kctl get nodes -o wide 2>&1 | tee -a "$LOG_FILE"
    echo
    kctl get pods -n kube-system 2>&1 | tee -a "$LOG_FILE"
    echo

    local not_ready
    not_ready="$(kctl get pods -n kube-system --no-headers 2>/dev/null \
        | awk '$3 != "Running" && $3 != "Completed" {print $1}' || true)"
    if [[ -n "$not_ready" ]]; then
        log_warning "Some kube-system pods are not Running yet: $(echo "$not_ready" | tr '\n' ' ')"
    fi
    log_success "Cluster validation passed."
}

# Full control plane workflow
install_control_plane() {
    log_info "Starting CONTROL PLANE installation..."
    prepare_node "control-plane"
    pull_k8s_images
    init_control_plane
    configure_kubectl_user
    install_calico
    generate_join_command
    validate_cluster
    log_success "Control plane installation completed successfully."
    if [[ -f /var/run/reboot-required ]]; then
        log_warning "Reboot required to finish OS updates. Run 'sudo reboot' at a convenient time."
    fi
}

#-------------------------------------------------------------------------------
# Worker node specific functions
#-------------------------------------------------------------------------------

# Prompt for and validate join parameters
prompt_join_details() {
    local input
    echo
    log_info "Enter the join details printed by 'kubeadm init' on the control plane."

    while true; do
        read -rp "Control Plane IP: " input
        if is_valid_ipv4 "$input"; then CP_IP="$input"; break; fi
        log_error "Invalid IPv4 address. Try again."
    done

    while true; do
        read -rp "kubeadm token (e.g. abcdef.0123456789abcdef): " input
        if [[ "$input" =~ ^[a-z0-9]{6}\.[a-z0-9]{16}$ ]]; then JOIN_TOKEN="$input"; break; fi
        log_error "Invalid token format. Expected [a-z0-9]{6}.[a-z0-9]{16}."
    done

    while true; do
        read -rp "discovery-token-ca-cert-hash (sha256:...): " input
        input="${input#sha256:}"
        if [[ "$input" =~ ^[a-f0-9]{64}$ ]]; then CA_HASH="sha256:${input}"; break; fi
        log_error "Invalid hash. Expected 64 hex characters (optionally prefixed with 'sha256:')."
    done
}

# Verify the control plane API port is reachable
check_control_plane_reachable() {
    log_info "Checking connectivity to ${CP_IP}:${API_PORT}..."
    if ! timeout 10 bash -c "</dev/tcp/${CP_IP}/${API_PORT}" 2>/dev/null; then
        die "Cannot reach ${CP_IP}:${API_PORT}. Check IP, routing and firewall."
    fi
    log_success "Control plane API port is reachable."
}

# Join this node to the cluster (skipped if already joined)
join_cluster() {
    if [[ -f "$KUBELET_CONF" ]]; then
        log_warning "This node already appears to be joined (${KUBELET_CONF} exists); skipping join."
        return 0
    fi
    check_control_plane_reachable
    log_info "Joining the cluster..."
    if ! kubeadm join "${CP_IP}:${API_PORT}" \
            --token "$JOIN_TOKEN" \
            --discovery-token-ca-cert-hash "$CA_HASH" \
            --cri-socket "$CRI_SOCKET" 2>&1 | tee -a "$LOG_FILE"; then
        die "kubeadm join failed. Verify the token has not expired and the hash is correct."
    fi
    log_success "kubeadm join completed."
}

# Confirm the kubelet started and registered with the control plane
validate_worker_registration() {
    log_info "Validating node registration..."
    local elapsed=0 timeout=180
    while (( elapsed < timeout )); do
        if systemctl is-active --quiet kubelet && [[ -f "$KUBELET_CONF" ]] && [[ -s "$KUBELET_CLIENT_CERT" ]]; then
            local registered
            registered="$(journalctl -u kubelet --no-pager 2>/dev/null | grep -c 'Successfully registered node' || true)"
            if (( ${registered:-0} > 0 )); then
                log_info "kubelet reports successful node registration."
            fi
            log_success "kubelet is active and authenticated with the control plane."
            log_info "Confirm on the control plane with: kubectl get nodes -o wide"
            return 0
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    die "Node did not register within ${timeout}s. Check: journalctl -u kubelet -n 100"
}

# Full worker workflow
install_worker_node() {
    log_info "Starting WORKER NODE installation..."
    prepare_node "worker"
    prompt_join_details
    join_cluster
    validate_worker_registration
    log_success "Worker node installation completed successfully."
    if [[ -f /var/run/reboot-required ]]; then
        log_warning "Reboot required to finish OS updates. Run 'sudo reboot' at a convenient time."
    fi
}

#-------------------------------------------------------------------------------
# Menu interface
#-------------------------------------------------------------------------------
show_menu() {
    echo "${C_CYAN}===================================================${C_RESET}"
    echo "${C_BOLD}         Kubernetes Cluster Setup${C_RESET}"
    echo "${C_CYAN}===================================================${C_RESET}"
    echo "1. Install Control Plane"
    echo "2. Install Worker Node"
    echo "3. Exit"
    echo "${C_CYAN}===================================================${C_RESET}"
}

#-------------------------------------------------------------------------------
# Main execution block
#-------------------------------------------------------------------------------
main() {
    check_root
    init_log
    acquire_lock
    validate_config

    local choice
    while true; do
        show_menu
        read -rp "Select an option [1-3]: " choice
        case "$choice" in
            1) install_control_plane; break ;;
            2) install_worker_node;   break ;;
            3) log_info "Exiting without changes."; exit 0 ;;
            *) log_warning "Invalid selection '${choice}'. Choose 1, 2 or 3."; echo ;;
        esac
    done
}

main "$@"
